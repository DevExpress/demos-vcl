  <Parameters>
    <Item1 Ref="4" Description="Date Range" ValueSourceSettings="#Ref-2" ValueInfo="5" Name="Range" Type="#Ref-3" />
    <Item2 Ref="6" Visible="false" Description="startDate" ValueInfo="2018-01-01" Name="StartDateRange" Type="#Ref-5" />
  </Parameters>
  <CalculatedFields>
    <Item1 Ref="7" Name="TotalIncome" FieldType="Decimal" Expression="[ConstructionIncome] + [SalesIncome]" />
    <Item2 Ref="8" Name="TotalCostOfGoodsSold" FieldType="Decimal" Expression="[CostOfGoodsSold] + [JobExpenses]" />
    <Item3 Ref="9" Name="GrossProfit" FieldType="Decimal" Expression="[TotalIncome] - [TotalCostOfGoodsSold]" />
    <Item4 Ref="10" Name="TotalExpense" FieldType="Decimal" Expression="[Automobile] + [BankServiceCharges] + [Insurance] + [PayrollExpenses] + [Repairs] + [ToolsAndMachinery]" />
    <Item5 Ref="11" Name="NetOrdinaryIncome" FieldType="Decimal" Expression="[GrossProfit] - [TotalExpense]" />
    <Item6 Ref="12" Name="StartDate" FieldType="DateTime" Expression="Iif(?Range == 1, ?StartDateRange, &#xA;?Range == 2, AddMonths(?StartDateRange, 3),&#xA;?Range == 3, AddMonths(?StartDateRange, 6),&#xA;?Range=4, AddMonths(?StartDateRange, 9),&#xA;?Range == 6, AddMonths(?StartDateRange, 6),&#xA;?StartDateRange)" />
    <Item7 Ref="13" Name="EndDate" FieldType="DateTime" Expression="AddDays(&#xA;Iif(?Range == 1, AddMonths(?StartDateRange, 3),&#xA;?Range==2, AddMonths(?StartDateRange, 6),&#xA;?Range == 3, AddMonths(?StartDateRange, 9),&#xA;?Range=4, AddMonths(?StartDateRange, 12),&#xA;?Range ==6, AddMonths(?StartDateRange, 12),&#xA;AddMonths(?StartDateRange, 6)), &#xA;-1)" />
